{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/utab5049/SIOS-Workspace-Standard/blob/main/02-Research/Registry/schemas/gdr.schema.json",
  "title": "SIOS Governance Decision Record",
  "description": "Contract for decisions and their authority/evidence history. This schema does not confer approval authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "title",
    "status",
    "scope",
    "authority",
    "rationale",
    "evidence",
    "history"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "pending",
        "approved",
        "rejected",
        "superseded",
        "withdrawn",
        "unresolved"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_or_body",
        "basis",
        "approval_record"
      ],
      "properties": {
        "owner_or_body": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "approval_record": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "selected_option": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "effective_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "claim",
          "verification_status"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "verification_status": {
            "enum": [
              "verified",
              "unverified",
              "disputed",
              "unavailable",
              "not_applicable"
            ]
          }
        }
      }
    },
    "affected_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "implementation_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "event",
          "source"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
