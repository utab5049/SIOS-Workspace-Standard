{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/utab5049/SIOS-Workspace-Standard/blob/main/02-Research/Registry/schemas/oai.schema.json",
  "title": "SIOS Operational Artifact Inventory Record",
  "description": "Contract for artifact inventory metadata. Inventory records do not confer governance approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "title",
    "path",
    "version",
    "lifecycle_state",
    "provenance",
    "reconciliation_status"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": [
        "string",
        "null"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle_state": {
      "enum": [
        "draft",
        "candidate",
        "approved",
        "frozen",
        "registered",
        "deprecated",
        "retired",
        "failed",
        "unknown",
        "disputed"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "domain": {
      "type": [
        "string",
        "null"
      ]
    },
    "collection": {
      "type": [
        "string",
        "null"
      ]
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_decision_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_path",
          "source_claim",
          "source_status"
        ],
        "properties": {
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "source_commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_claim": {
            "type": "string",
            "minLength": 1
          },
          "source_status": {
            "enum": [
              "current",
              "historical",
              "conflicting",
              "unverified",
              "unavailable"
            ]
          }
        }
      }
    },
    "reconciliation_status": {
      "enum": [
        "reconciled",
        "pending",
        "disputed",
        "unverified",
        "not_started"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
